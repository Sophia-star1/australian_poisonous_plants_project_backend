# Application
APP_NAME=apl-backend
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (Supabase)
# Format: postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/apl_db

# Redis (optional — leave empty to skip)
REDIS_URL=

# Supabase Storage — REQUIRED for contributor photos to be persisted.
# Without these the app still boots and accepts uploads, but the bytes are
# discarded and a warning is logged on startup and on every write.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses row level security. Keep it server-side:
# Cloud Run secret or .env only, never in the mobile bundle or a web client.
# Find both under Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SUBMISSION_BUCKET=submission-images
SUPABASE_PLANT_BUCKET=plant-images

# Upload limits
MAX_UPLOAD_BYTES=10485760
ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/webp"]

# AWS S3 (unused — superseded by Supabase Storage above)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT_URL=

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Email — notifies a contributor when their submission is approved or rejected.
# Optional: without RESEND_API_KEY the app runs normally and logs each message
# it would have sent, so nothing breaks in a checkout that has no key.
#
# Get a key at https://resend.com (free tier: 3000/month, 100/day).
# EMAIL_FROM defaults to Resend's shared test sender, which needs no domain
# verification but ONLY delivers to the address that owns the API key. Point it
# at a verified domain before anyone else is meant to receive mail.
RESEND_API_KEY=
EMAIL_FROM=Australian Poisonous Plants <onboarding@resend.dev>
EMAIL_REPLY_TO=

# Badges — thresholds as JSON lists, lowest first, strictly increasing.
# CONTRIBUTOR_TREE_STAGES: approved submissions for each growth stage of the
# contributor's tree (one picture per stage in the app).
# REVIEWER_BADGE_TIERS: decided submissions (approved or rejected) for each
# reviewer badge. PLACEHOLDERS until the real tiers are decided. Nothing is
# stored per user, so changing either re-grades every account immediately.
CONTRIBUTOR_TREE_STAGES=[1,3,5,10,20]
REVIEWER_BADGE_TIERS=[10,50,100,250]

# Celery (optional — leave empty to skip)
CELERY_BROKER_URL=
