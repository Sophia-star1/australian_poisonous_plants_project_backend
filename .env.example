# Application
APP_NAME=apl-backend
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (Supabase)
# Format: postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/apl_db

# Redis (optional — leave empty to skip)
REDIS_URL=

# Photo storage — REQUIRED for photos (submissions, approved plant photos,
# avatars) to be persisted. Configure ONE of: Supabase Storage, or any
# S3-compatible service (AWS S3, Cloudflare R2, RustFS, ...). With neither the
# app still boots and accepts uploads, but the bytes are discarded and a
# warning is logged on startup and on every write.
#
# STORAGE_BACKEND: auto | supabase | s3. "auto" uses Supabase when both
# SUPABASE_* values are set, otherwise S3 when AWS_S3_BUCKET and
# S3_PUBLIC_BASE_URL are set. Set it explicitly in production.
STORAGE_BACKEND=auto

# Bucket names. With Supabase these are three public buckets, created on
# deploy by `python -m app.db.migrate` if missing. With S3 they are key
# prefixes inside AWS_S3_BUCKET.
SUPABASE_SUBMISSION_BUCKET=submission-images
SUPABASE_PLANT_BUCKET=plant-images-v2
SUPABASE_AVATAR_BUCKET=avatars

# Option A: Supabase Storage.
# SUPABASE_SERVICE_ROLE_KEY bypasses row level security. Keep it server-side:
# a secret manager or .env only, never in the mobile bundle or a web client.
# Find both under Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Option B: S3-compatible storage. One bucket, which must already exist and
# be publicly readable (bucket policy, R2 public domain, or a CDN):
# `<S3_PUBLIC_BASE_URL>/<key>` must serve the object stored at `<key>`.
#   AWS S3:  AWS_S3_ENDPOINT_URL empty, AWS_REGION=ap-southeast-2,
#            S3_PUBLIC_BASE_URL=https://<bucket>.s3.ap-southeast-2.amazonaws.com
#   R2:      AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com,
#            AWS_REGION=auto, S3_PUBLIC_BASE_URL=https://<public-r2-domain>
#   Self-hosted (RustFS, as in docker-compose.yml):
#            AWS_S3_ENDPOINT_URL=http://storage:9000,
#            S3_PUBLIC_BASE_URL=https://<public-host>/<bucket>
AWS_S3_BUCKET=
AWS_S3_ENDPOINT_URL=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Docker Compose stack only (docker-compose.yml). Compose refuses to start
# until the three secrets are set; use letters and digits only, since the
# database password is placed inside a URL. PUBLIC_MEDIA_URL is the address
# phones load photos from: the storage container's port 9000 behind your
# HTTPS proxy, followed by /apl-media.
POSTGRES_PASSWORD=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
PUBLIC_MEDIA_URL=http://localhost:9000/apl-media

# Upload limits
MAX_UPLOAD_BYTES=10485760
ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/webp"]

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Email — notifies a contributor when their submission is approved or rejected.
# Optional: with neither SMTP nor Resend configured the app runs normally and
# logs each message it would have sent, so nothing breaks in a bare checkout.
#
# SMTP (used whenever SMTP_HOST is set) — production sends through the domain's
# Namecheap Private Email mailbox. EMAIL_FROM must be that same mailbox. Port
# 587 upgrades with STARTTLS; 465 uses implicit TLS. Never commit the password:
# production reads it from Secret Manager (`smtp-password`).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
#
# Resend (used when SMTP_HOST is empty) — get a key at https://resend.com.
# Its shared test sender onboarding@resend.dev needs no domain verification but
# ONLY delivers to the address that owns the API key.
RESEND_API_KEY=
EMAIL_FROM=Australian Poisonous Plants <onboarding@resend.dev>
EMAIL_REPLY_TO=

# Badges — thresholds as JSON lists, lowest first, strictly increasing.
# CONTRIBUTOR_TREE_STAGES: approved submissions for each growth stage of the
# contributor's tree (one picture per stage in the app).
# REVIEWER_BADGE_TIERS: decided submissions (approved or rejected) for each
# reviewer badge. PLACEHOLDERS until the real tiers are decided. Nothing is
# stored per user, so changing either re-grades every account immediately.
CONTRIBUTOR_TREE_STAGES=[1,3,5,10,20]
REVIEWER_BADGE_TIERS=[10,50,100,250]
