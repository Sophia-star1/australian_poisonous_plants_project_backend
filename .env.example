# Application
APP_NAME=apl-backend
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (Supabase)
# Format: postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/apl_db

# Redis (optional — leave empty to skip)
REDIS_URL=

# Object Storage (optional — leave empty to skip)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT_URL=

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Celery (optional — leave empty to skip)
CELERY_BROKER_URL=
