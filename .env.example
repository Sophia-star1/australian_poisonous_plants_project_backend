# Application
APP_NAME=apl-backend
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (Supabase)
# Format: postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/apl_db

# Redis (optional — leave empty to skip)
REDIS_URL=

# Supabase Storage — REQUIRED for contributor photos to be persisted.
# Without these the app still boots and accepts uploads, but the bytes are
# discarded and a warning is logged on startup and on every write.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses row level security. Keep it server-side:
# Cloud Run secret or .env only, never in the mobile bundle or a web client.
# Find both under Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SUBMISSION_BUCKET=submission-images
SUPABASE_PLANT_BUCKET=plant-images

# Upload limits
MAX_UPLOAD_BYTES=10485760
ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/webp"]

# AWS S3 (unused — superseded by Supabase Storage above)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT_URL=

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Celery (optional — leave empty to skip)
CELERY_BROKER_URL=
