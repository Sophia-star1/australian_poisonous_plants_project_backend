# 统一换行符：仓库内一律存 LF，检出到工作区也用 LF。
# 后端跑在 Docker/Linux 上，保持 LF 可避免 Windows/Linux 之间的伪差异。
* text=auto eol=lf

# 必须是 LF（否则在 Linux 下无法执行 / 解析异常）
*.sh        text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Windows 脚本必须是 CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf

# 二进制文件，不做任何转换
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.pdf       binary
*.zip       binary
*.gz        binary
*.db        binary
*.sqlite3   binary
*.woff      binary
*.woff2     binary
*.ttf       binary
